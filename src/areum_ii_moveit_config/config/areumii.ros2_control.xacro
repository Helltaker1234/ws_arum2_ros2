<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="areumii_ros2_control" params="name initial_positions_file ros2_control_hardware_type">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <xacro:if value="${ros2_control_hardware_type == 'mock_components'}">
          <ros2_control name="${name}" type="system">
              <hardware>
                <plugin>mock_components/GenericSystem</plugin>
              </hardware>
              <joint name="shoulder_pitch_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['shoulder_pitch_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="shoulder_roll_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['shoulder_roll_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="shouler_yaw_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['shouler_yaw_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="elbow_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['elbow_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="wrist_roll_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_roll_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="wrist_yaw_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_yaw_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="wrist_pitch_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_pitch_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="shoulder_pitch_joint_R">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['shoulder_pitch_joint_R']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="shoulder_roll_joint_R">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['shoulder_roll_joint_R']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="shoulder_yaw_joint_R">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['shoulder_yaw_joint_R']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="elbow_joint_R">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['elbow_joint_R']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="wrist_roll_joint_R">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_roll_joint_R']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="wrist_yaw_joint_R">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_yaw_joint_R']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="wrist_pitch_joint_R">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_pitch_joint_R']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="gripper_left_finger_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['gripper_left_finger_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="gripper_right_finger_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['gripper_right_finger_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="gripper_left_finger_joint_R">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['gripper_left_finger_joint_R']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="gripper_right_finger_joint_R">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['gripper_right_finger_joint_R']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>

          </ros2_control>
        </xacro:if>

        <xacro:if value="${ros2_control_hardware_type == 'real_hardware'}">
          <ros2_control name="${name}" type="system">
              <hardware>
                <plugin>areumii_hardware_interface/AreumiiHardwareInterface</plugin>
              </hardware>
              <joint name="shoulder_pitch_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['shoulder_pitch_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="shoulder_roll_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['shoulder_roll_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="shouler_yaw_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['shouler_yaw_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="elbow_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['elbow_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="wrist_roll_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_roll_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="wrist_yaw_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_yaw_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="wrist_pitch_joint_L">
                  <command_interface name="position"/>
                  <command_interface name="velocity"/>
                  <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_pitch_joint_L']}</param>
                  </state_interface>
                  <state_interface name="velocity"/>
              </joint>
              <joint name="shoulder_pitch_joint_R">

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="areumii">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import areumii urdf file -->
    <xacro:include filename="$(find areumii_description)/urdf/areumii.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="areumii.ros2_control.xacro" />

    <!-- [base_link > camera_link TF]  -->
    <xacro:include filename="areumii.camera_frame.xacro" /> 

    <xacro:areumii_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
